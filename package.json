{
  "name": "dailyloop",
  "private": true,
  "version": "0.1.0",
  "description": "DailyLoop \u2014 a daily puzzle platform with streaks, scoring, and friends.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @dailyloop/api\" \"npm run dev -w @dailyloop/web\"",
    "build": "npm run build -w @dailyloop/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:test:migrate": "DATABASE_URL=\"postgresql://dailyloop_test:dailyloop_test_password@localhost:5433/dailyloop_test\" prisma migrate deploy --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dailyloop/game-engine": "*",
    "@dailyloop/shared": "*",
    "@prisma/client": "^6.2.1",
    "argon2": "^0.45.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "playwright": "1.63.0",
    "prettier": "^3.10.0",
    "prisma": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "argon2@0.41.1": true,
    "prisma@6.19.3": true
  },
  "overrides": {
    "effect": "^3.22.5",
    "deepmerge-ts": "^8.0.2",
    "jsdom": "31.0.0"
  }
}
