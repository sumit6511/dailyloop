# Used only by `npm test`. Points at the disposable postgres_test container
# (see docker-compose.yml) so tests never touch your dev database.
DATABASE_URL="postgresql://dailyloop_test:dailyloop_test_password@localhost:5433/dailyloop_test"
NODE_ENV=test
CORS_ORIGIN="http://localhost:5173"
WEB_APP_URL="http://localhost:5173"
APP_SECRET="test-only-secret-00000000000000000000000000000000"
DEFAULT_TIMEZONE="Asia/Kathmandu"
