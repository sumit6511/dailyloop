# Copy this file to .env and adjust as needed. Never commit the real .env.

# --- Database ---
# Matches docker-compose.yml by default. Run `npm run db:up` to start it.
DATABASE_URL="postgresql://dailyloop:dailyloop_dev_password@localhost:5432/dailyloop"

# --- API server (apps/api) ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins for CORS + CSRF origin-check.
CORS_ORIGIN="http://localhost:5173"
# Public URL of the web app, used to build links (e.g. password reset emails).
WEB_APP_URL="http://localhost:5173"
# Random 32+ char secret used to sign nothing sensitive directly, but mixed into
# hashing salts for extra defense-in-depth. Generate with: openssl rand -hex 32
APP_SECRET="dev-only-secret-change-me-00000000000000000000000000"
# Default IANA timezone used for daily puzzle rollover.
DEFAULT_TIMEZONE="Asia/Kathmandu"

# --- Frontend (apps/web) ---
VITE_API_URL="http://localhost:4000/api"
